# Copy to .env (or export) to use a real model. With no key, everything runs in offline demo mode.
LLM_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=
# To use OpenAI instead: LLM_MODEL=openai/gpt-4o and set OPENAI_API_KEY
OPENAI_API_KEY=
# Force the offline rule-based MockLLM even if a key is set:
# LLM_MODEL=mock
